%%{init: {"theme":"base","themeVariables":{"fontFamily":"Inter, Segoe UI, Arial, sans-serif","fontSize":"15px","primaryColor":"#E6F4F4","primaryTextColor":"#1C1917","primaryBorderColor":"#0F6E6E","secondaryColor":"#C7E8E8","tertiaryColor":"#FAFAF9","lineColor":"#57534E","textColor":"#1C1917","mainBkg":"#E6F4F4","nodeBorder":"#0F6E6E","clusterBkg":"#F5F5F4","clusterBorder":"#A8A29E","edgeLabelBackground":"#FFFFFF","attributeBackgroundColorOdd":"#FFFFFF","attributeBackgroundColorEven":"#F5F5F4"},"er":{"useMaxWidth":false},"flowchart":{"useMaxWidth":false,"htmlLabels":true,"curve":"basis"}}}%%
erDiagram
    direction LR
    ACOPIO ||--o{ MOVIMIENTO : registra
    CATEGORIA ||--o{ MOVIMIENTO : clasifica
    USUARIO ||--o{ MOVIMIENTO : captura
    ACOPIO ||--o{ SALDO : tiene
    CATEGORIA ||--o{ SALDO : suma
    MOVIMIENTO }o--|| SALDO : "actualiza por disparador"

    ACOPIO {
        uuid id PK "clúster Red"
    }
    CATEGORIA {
        uuid id PK "clúster Raíz y catálogo"
    }
    USUARIO {
        uuid id PK "clúster Identidad"
    }
    MOVIMIENTO {
        uuid id PK "id del cliente: la cola sin red no duplica"
        uuid acopio_id FK
        uuid categoria_id FK
        uuid usuario_id FK
        text tipo "ENTRADA | SALIDA | AJUSTE"
        numeric cantidad "> 0"
        smallint signo
        text motivo_salida "solo SALIDA"
        text motivo "AJUSTE: 10 caracteres o más"
        date vence_en "solo ENTRADA perecedera"
        timestamptz ocurrido_en
        timestamptz registrado_en
        bool origen_offline
        bigint secuencia UK
    }
    SALDO {
        uuid acopio_id PK,FK
        uuid categoria_id PK,FK
        numeric cantidad ">= 0"
        timestamptz ultimo_movimiento
    }

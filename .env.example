# Copiar a .env y llenar. .env nunca se versiona.

# ── Base de datos ───────────────────────────────────────────────
# Dueño de la base: corre las migraciones y el seed
POSTGRES_USER=acopio_owner
POSTGRES_PASSWORD=cambiar-dueno
POSTGRES_DB=acopio
# Rol de la API: sin UPDATE ni DELETE sobre la bitácora
APP_DB_PASSWORD=cambiar-app
# Conexión de la API (rol acopio_app)
DATABASE_URL=postgresql://acopio_app:cambiar-app@localhost:5432/acopio
# Conexión de migraciones y seed (dueño)
DATABASE_URL_OWNER=postgresql://acopio_owner:cambiar-dueno@localhost:5432/acopio

# ── Autenticación (P-025) ───────────────────────────────────────
# local: la API emite el token. supabase: lo emite Supabase Auth.
# La API no arranca con «local» si NODE_ENV=production.
AUTH_PROVEEDOR=local
# Con «local» apunta a la propia API
SUPABASE_JWKS_URL=http://localhost:3000/api/auth/.well-known/jwks.json
# Carpeta donde el adaptador local guarda su par de llaves RS256
AUTH_LLAVES_DIR=./.llaves
# Solo con AUTH_PROVEEDOR=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # SECRETO · solo backend · nunca VITE_*

# ── Almacenamiento ──────────────────────────────────────────────
MINIO_ROOT_USER=acopio
MINIO_ROOT_PASSWORD=cambiar-minio
MINIO_BUCKET=comprobantes

# ── Correo ──────────────────────────────────────────────────────
# En desarrollo, Mailpit (sin usuario ni contraseña)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SEGURO=false
CORREO_REMITENTE="Acopio <no-responder@acopio.local>"

# ── Aplicación ──────────────────────────────────────────────────
APP_URL=http://localhost:5173   # base de los enlaces de invitación
API_PUERTO=3000
NODE_ENV=development

# ── Seed: primer administrador ──────────────────────────────────
SEED_ADMIN_USUARIO=admin
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_CORREO=admin@acopio.local
SEED_ADMIN_CONTRASENA=cambiar-antes-de-usar

{
  "name": "acopio",
  "private": true,
  "description": "Coordinación logística para respuesta a desastres · IS1 ETITC",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun run --workspaces --if-present test",
    "test:int": "bun run --workspaces --if-present test:int",
    "servicios": "docker compose --env-file .env -f infra/docker-compose.yml -f infra/docker-compose.dev.yml up -d db storage mailpit",
    "servicios:parar": "docker compose --env-file .env -f infra/docker-compose.yml -f infra/docker-compose.dev.yml down",
    "servicios:logs": "docker compose --env-file .env -f infra/docker-compose.yml -f infra/docker-compose.dev.yml logs -f",
    "servicios:todo": "docker compose --env-file .env -f infra/docker-compose.yml -f infra/docker-compose.dev.yml up -d --build",
    "almacenamiento:iniciar": "./infra/garage/iniciar.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "22",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "trustedDependencies": [
    "prisma",
    "@prisma/engines",
    "@prisma/client"
  ]
}

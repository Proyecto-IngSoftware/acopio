// Esquema de Acopio · Bloques 0 y 1 (identidad, auditoría, notificaciones, catálogo, red).
// Fuente de verdad del diseño: docs/02-arquitectura/modelo-datos.md.
// Las restricciones que Prisma no expresa (CHECK, permisos por rol) viven en el SQL
// de cada migración.

generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generado/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ── Identidad ────────────────────────────────────────────────────────────────

enum Rol {
  ADMIN
  OPERADOR
  AUDITOR
  RECEPTOR
  DONADOR
}

enum EstadoUsuario {
  INVITADO
  ACTIVO
  SUSPENDIDO
}

enum TipoUbicacion {
  ACOPIO
  ZONA
}

model Usuario {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username             String?       @unique @db.Citext
  nombre               String
  correo               String?       @unique @db.Citext
  correo_sintetico     Boolean       @default(false)
  rol                  Rol
  /// `sub` del proveedor de identidad activo (local o Supabase). Sin llave foránea.
  supabase_uid         String?       @unique @db.Uuid
  estado               EstadoUsuario @default(INVITADO)
  /// Tokens emitidos antes de esta fecha se rechazan. Se mueve al restablecer el
  /// acceso (RF-IDE-009): la sesión anterior deja de servir sin esperar a que venza.
  tokens_validos_desde DateTime?     @db.Timestamptz
  creado_en            DateTime      @default(now()) @db.Timestamptz

  asignaciones         UsuarioAsignacion[]     @relation("asignaciones")
  asignaciones_hechas  UsuarioAsignacion[]     @relation("asignado_por")
  invitaciones         Invitacion[]            @relation("invitado")
  invitaciones_creadas Invitacion[]            @relation("creada_por")
  verificaciones       VerificacionCorreo[]
  bitacora             Bitacora[]
  movimientos          Movimiento[]
  donaciones           Comprobante[]           @relation("donaciones")
  recibidas            Comprobante[]           @relation("recibidas")
  verificadas          Comprobante[]           @relation("verificadas")
  vinculos_hechos      ComprobanteMovimiento[] @relation("vinculos_hechos")

  @@map("usuario")
}

model UsuarioAsignacion {
  usuario_id     String        @db.Uuid
  ubicacion_tipo TipoUbicacion
  /// Acopio o zona. Sin llave foránea: apunta a dos tablas distintas.
  ubicacion_id   String        @db.Uuid
  asignado_por   String        @db.Uuid
  asignado_en    DateTime      @default(now()) @db.Timestamptz

  usuario   Usuario @relation("asignaciones", fields: [usuario_id], references: [id])
  asignador Usuario @relation("asignado_por", fields: [asignado_por], references: [id])

  @@id([usuario_id, ubicacion_tipo, ubicacion_id])
  @@index([usuario_id, ubicacion_id])
  @@map("usuario_asignacion")
}

model Invitacion {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id          String    @db.Uuid
  /// SHA-256 del token. El token en claro no se guarda (RF-IDE-002).
  token_hash          Bytes     @unique
  expira_en           DateTime  @db.Timestamptz
  usada_en            DateTime? @db.Timestamptz
  revocada_en         DateTime? @db.Timestamptz
  es_restablecimiento Boolean   @default(false)
  motivo              String?
  creada_por          String?   @db.Uuid
  creada_en           DateTime  @default(now()) @db.Timestamptz

  usuario Usuario  @relation("invitado", fields: [usuario_id], references: [id])
  creador Usuario? @relation("creada_por", fields: [creada_por], references: [id])

  @@index([usuario_id])
  @@map("invitacion")
}

/// Credenciales del adaptador de autenticación local (P-025). Hace lo que después
/// hará Supabase Auth; se exporta y se elimina al migrar.
model IdentidadLocal {
  /// Es el `sub` del token y el valor de usuario.supabase_uid.
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correo               String    @unique @db.Citext
  password_hash        String
  correo_confirmado_en DateTime? @db.Timestamptz
  creado_en            DateTime  @default(now()) @db.Timestamptz

  @@map("identidad_local")
}

// ── Auditoría ────────────────────────────────────────────────────────────────

/// Append-only: el rol de la API no tiene UPDATE ni DELETE (RF-IDE-012, RNF-10).
model Bitacora {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Nulo en acciones del sistema: seed y tareas programadas.
  usuario_id    String?  @db.Uuid
  accion        String
  entidad       String
  entidad_id    String?
  ubicacion_id  String?  @db.Uuid
  datos_antes   Json?
  datos_despues Json?
  destacado     Boolean  @default(false)
  ocurrido_en   DateTime @default(now()) @db.Timestamptz

  usuario Usuario? @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id, ocurrido_en])
  @@index([entidad, entidad_id])
  @@index([ocurrido_en])
  @@map("bitacora")
}

// ── Notificaciones ───────────────────────────────────────────────────────────

enum EstadoCorreo {
  PENDIENTE
  ENVIADO
  FALLIDO
}

model CorreoSaliente {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  destinatario      String       @db.Citext
  asunto            String
  cuerpo_texto      String
  cuerpo_html       String?
  estado            EstadoCorreo @default(PENDIENTE)
  intentos          Int          @default(0)
  ultimo_error      String?
  enviar_despues_de DateTime     @default(now()) @db.Timestamptz
  creado_en         DateTime     @default(now()) @db.Timestamptz
  enviado_en        DateTime?    @db.Timestamptz

  @@index([estado, enviar_despues_de])
  @@map("correo_saliente")
}

// ── Catálogo ─────────────────────────────────────────────────────────────────

enum GrupoCategoria {
  ALIMENTOS
  AGUA_Y_BEBIDAS
  ASEO_PERSONAL
  ASEO_DEL_HOGAR
  SALUD
  ROPA_Y_ABRIGO
  BEBE
  ADULTO_MAYOR
  ANIMALES
  HERRAMIENTAS
}

enum UnidadBase {
  LITRO
  KILOGRAMO
  UNIDAD
}

model Categoria {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String         @unique @db.Citext
  grupo       GrupoCategoria
  unidad_base UnidadBase
  perecedero  Boolean        @default(false)
  sinonimos   String[]       @default([])
  archivada   Boolean        @default(false)
  creado_en   DateTime       @default(now()) @db.Timestamptz

  canasta            CanastaEstandar[]
  no_recibir         NoRecibir[]
  movimientos        Movimiento[]
  saldos             Saldo[]
  umbrales           Umbral[]
  codigos_barras     CodigoBarras[]
  lineas_comprobante LineaComprobante[]

  @@map("categoria")
}

/// Versionada por vigente_desde: cambiarla no reescribe el histórico (RF-CAT-003).
model CanastaEstandar {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoria_id         String   @db.Uuid
  cantidad_persona_dia Decimal  @db.Decimal(12, 4)
  fuente               String
  vigente_desde        DateTime @db.Date
  creado_en            DateTime @default(now()) @db.Timestamptz

  categoria Categoria @relation(fields: [categoria_id], references: [id])

  @@unique([categoria_id, vigente_desde])
  @@map("canasta_estandar")
}

enum EstadoEmergencia {
  ACTIVA
  EN_SEGUIMIENTO
  CERRADA
}

model Emergencia {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String
  tipo            String
  inicio          DateTime         @db.Date
  horizonte_dias  Int              @default(7)
  estado          EstadoEmergencia @default(ACTIVA)
  destacada_hasta DateTime         @db.Date
  cerrada_en      DateTime?        @db.Timestamptz
  motivo_cierre   String?
  creado_en       DateTime         @default(now()) @db.Timestamptz
  zonas           Zona[]

  @@map("emergencia")
}

// ── Red (Bloque 1) ──────────────────────────────────────────────────────────

enum EstadoVerificacion {
  SIN_VERIFICAR
  VERIFICADA
  RECHAZADA
}

enum EstadoAcopio {
  ACTIVO
  PAUSADO
  CERRADO
}

enum EstadoZona {
  SIN_ATENDER
  EN_ATENCION
  CUBIERTA
}

/// RF-RED-005. La verificación con documento llega con la especificación C.
model Entidad {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre       String             @unique @db.Citext
  tipo         String
  nit          String?
  sitio_web    String?
  telefono     String?
  correo       String?
  descripcion  String?
  verificacion EstadoVerificacion @default(SIN_VERIFICAR)
  creado_en    DateTime           @default(now()) @db.Timestamptz
  acopios      Acopio[]

  @@map("entidad")
}

/// RF-RED-001. Los acopios referenciados (tipo, fuente) llegan con el importador.
model Acopio {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entidad_id          String        @db.Uuid
  entidad             Entidad       @relation(fields: [entidad_id], references: [id])
  nombre              String
  direccion           String
  municipio           String
  lat                 Decimal       @db.Decimal(9, 6)
  lng                 Decimal       @db.Decimal(9, 6)
  telefono            String?
  indicaciones_acceso String?
  /// { lun: [{ abre: "08:00", cierra: "12:00" }], … } en hora de Bogotá
  horario             Json
  estado              EstadoAcopio  @default(ACTIVO)
  creado_en           DateTime      @default(now()) @db.Timestamptz
  actualizado_en      DateTime      @default(now()) @updatedAt @db.Timestamptz
  no_recibir          NoRecibir[]
  movimientos         Movimiento[]
  saldos              Saldo[]
  umbrales            Umbral[]
  comprobantes        Comprobante[]

  @@index([estado])
  @@map("acopio")
}

/// RF-MOT-001. Pertenece a una emergencia; cerrada la emergencia, queda en solo lectura.
model Zona {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emergencia_id      String     @db.Uuid
  emergencia         Emergencia @relation(fields: [emergencia_id], references: [id])
  nombre             String
  municipio          String
  lat                Decimal    @db.Decimal(9, 6)
  lng                Decimal    @db.Decimal(9, 6)
  poblacion_estimada Int
  poblacion_fuente   String
  poblacion_fecha    DateTime   @db.Date
  estado             EstadoZona @default(SIN_ATENDER)
  creado_en          DateTime   @default(now()) @db.Timestamptz
  actualizado_en     DateTime   @default(now()) @updatedAt @db.Timestamptz

  @@index([emergencia_id])
  @@map("zona")
}

/// RF-INV-008, adelantado al Bloque 1 (B-02, B-06). Módulo inventario.
/// Con `hasta` vencido la fila deja de contar al leerla.
model NoRecibir {
  acopio_id    String    @db.Uuid
  acopio       Acopio    @relation(fields: [acopio_id], references: [id])
  categoria_id String    @db.Uuid
  categoria    Categoria @relation(fields: [categoria_id], references: [id])
  hasta        DateTime? @db.Date
  marcado_por  String    @db.Uuid
  marcado_en   DateTime  @default(now()) @db.Timestamptz

  @@id([acopio_id, categoria_id])
  @@index([categoria_id])
  @@map("no_recibir")
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

enum MotivoSalida {
  ENTREGA_FAMILIAS
  TRASLADO
  VENCIDO
  OTRO
}

/// Append-only (ADR-0002): acopio_app solo SELECT e INSERT. Un error se corrige con un AJUSTE.
/// El id puede venir del cliente: es la llave de idempotencia de la captura sin conexión.
model Movimiento {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  acopio_id      String                 @db.Uuid
  acopio         Acopio                 @relation(fields: [acopio_id], references: [id])
  categoria_id   String                 @db.Uuid
  categoria      Categoria              @relation(fields: [categoria_id], references: [id])
  tipo           TipoMovimiento
  cantidad       Decimal                @db.Decimal(12, 3)
  signo          Int                    @db.SmallInt
  motivo_salida  MotivoSalida?
  nota           String?
  motivo         String?
  vence_en       DateTime?              @db.Date
  usuario_id     String                 @db.Uuid
  usuario        Usuario                @relation(fields: [usuario_id], references: [id])
  ocurrido_en    DateTime               @db.Timestamptz
  registrado_en  DateTime               @default(now()) @db.Timestamptz
  origen_offline Boolean                @default(false)
  /// Orden en que entró a la base: ordena el historial y su saldo corriente. registrado_en
  /// es la hora de inicio de la transacción y no siempre coincide con ese orden.
  secuencia      BigInt                 @unique @default(autoincrement())
  vinculo        ComprobanteMovimiento?

  @@index([acopio_id, categoria_id, registrado_en])
  @@index([registrado_en])
  @@map("movimiento")
}

/// La mantiene el disparador movimiento_actualiza_saldo (ADR-0015). acopio_app solo SELECT.
model Saldo {
  acopio_id         String    @db.Uuid
  acopio            Acopio    @relation(fields: [acopio_id], references: [id])
  categoria_id      String    @db.Uuid
  categoria         Categoria @relation(fields: [categoria_id], references: [id])
  cantidad          Decimal   @db.Decimal(12, 3)
  ultimo_movimiento DateTime  @db.Timestamptz

  @@id([acopio_id, categoria_id])
  @@map("saldo")
}

/// Sin fila, la categoría no tiene umbral en ese acopio (V-03).
model Umbral {
  acopio_id       String    @db.Uuid
  acopio          Acopio    @relation(fields: [acopio_id], references: [id])
  categoria_id    String    @db.Uuid
  categoria       Categoria @relation(fields: [categoria_id], references: [id])
  minimo          Decimal   @db.Decimal(12, 3)
  maximo          Decimal   @db.Decimal(12, 3)
  actualizado_por String    @db.Uuid
  actualizado_en  DateTime  @default(now()) @db.Timestamptz

  @@id([acopio_id, categoria_id])
  @@map("umbral")
}

/// RF-CAT-004. Módulo catalogo. Un EAN que asocia un Operador queda sin revisar.
model CodigoBarras {
  ean          String    @id
  categoria_id String    @db.Uuid
  categoria    Categoria @relation(fields: [categoria_id], references: [id])
  contenido    Decimal?  @db.Decimal(12, 3)
  descripcion  String?
  creado_por   String    @db.Uuid
  creado_en    DateTime  @default(now()) @db.Timestamptz
  revisado     Boolean   @default(false)

  @@index([categoria_id])
  @@map("codigo_barras")
}

/// Confirmación del correo de un Donador (RF-IDE-013, C-03). Solo se guarda el hash.
model VerificacionCorreo {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id String    @db.Uuid
  usuario    Usuario   @relation(fields: [usuario_id], references: [id])
  token_hash Bytes     @unique
  vence_en   DateTime  @db.Timestamptz
  usado_en   DateTime? @db.Timestamptz
  creado_en  DateTime  @default(now()) @db.Timestamptz

  @@index([usuario_id])
  @@map("verificacion_correo")
}

enum EstadoComprobante {
  PREPARADO
  PENDIENTE
  CONCILIADO
  RECHAZADO
  CANCELADO
}

enum MotivoRechazo {
  DUPLICADO
  NO_CUADRA_MOVIMIENTOS
  DIFERENCIA_SIN_EXPLICAR
  OTRO
}

enum OrigenVinculo {
  RECEPCION
  AUDITOR
}

/// Una donación preparada por un Donador (RF-CMP-001B). Vale cuando se concilia.
model Comprobante {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folio                  String                  @unique
  donador_id             String                  @db.Uuid
  donador                Usuario                 @relation("donaciones", fields: [donador_id], references: [id])
  acopio_id              String                  @db.Uuid
  acopio                 Acopio                  @relation(fields: [acopio_id], references: [id])
  estado                 EstadoComprobante       @default(PREPARADO)
  creado_en              DateTime                @default(now()) @db.Timestamptz
  recibido_por           String?                 @db.Uuid
  recibido_por_usuario   Usuario?                @relation("recibidas", fields: [recibido_por], references: [id], onDelete: Restrict)
  recibido_en            DateTime?               @db.Timestamptz
  verificado_por         String?                 @db.Uuid
  verificado_por_usuario Usuario?                @relation("verificadas", fields: [verificado_por], references: [id], onDelete: Restrict)
  verificado_en          DateTime?               @db.Timestamptz
  motivo_rechazo         MotivoRechazo?
  nota_rechazo           String?
  cerrado_en             DateTime?               @db.Timestamptz
  factura_key            String?
  miniatura_key          String?
  factura_tipo           String?
  factura_bytes          Int?
  factura_borrada_en     DateTime?               @db.Timestamptz
  lineas                 LineaComprobante[]
  vinculos               ComprobanteMovimiento[]

  @@index([estado, acopio_id, creado_en])
  @@index([donador_id, estado])
  @@map("comprobante")
}

model LineaComprobante {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  comprobante_id      String      @db.Uuid
  comprobante         Comprobante @relation(fields: [comprobante_id], references: [id])
  categoria_id        String      @db.Uuid
  categoria           Categoria   @relation(fields: [categoria_id], references: [id])
  ean                 String?
  contenido_unitario  Decimal     @db.Decimal(12, 3)
  cantidad_declarada  Decimal     @db.Decimal(12, 3)
  cantidad_confirmada Decimal?    @db.Decimal(12, 3)
  vence_en            DateTime?   @db.Date
  motivo_diferencia   String?

  @@index([comprobante_id])
  @@map("linea_comprobante")
}

/// Solo inserción (C-05): une una donación con sus ENTRADA, al recibir o al vincular.
model ComprobanteMovimiento {
  comprobante_id        String        @db.Uuid
  comprobante           Comprobante   @relation(fields: [comprobante_id], references: [id])
  movimiento_id         String        @unique @db.Uuid
  movimiento            Movimiento    @relation(fields: [movimiento_id], references: [id])
  origen                OrigenVinculo
  vinculado_por         String        @db.Uuid
  vinculado_por_usuario Usuario       @relation("vinculos_hechos", fields: [vinculado_por], references: [id])
  vinculado_en          DateTime      @default(now()) @db.Timestamptz

  @@id([comprobante_id, movimiento_id])
  @@map("comprobante_movimiento")
}

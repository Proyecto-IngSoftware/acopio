# Herramientas personales de cada integrante; los hooks del proyecto sí se versionan
.claude/*
!.claude/settings.json
!.claude/hooks/
.agents/
skills-lock.json

# Estado local de Obsidian (la configuración compartida sí se versiona)
docs/.obsidian/workspace*.json
docs/.obsidian/cache

# Archivos de bloqueo de Word y del sistema
~$*
Thumbs.db
desktop.ini
.DS_Store

# Código (cuando exista)
node_modules/
dist/
coverage/
.env
.env.*
!.env.example

# Cliente de Prisma generado (bun run --filter @acopio/api db:generar)
apps/api/src/generado/

# Llaves del adaptador de autenticación local
.llaves/
apps/api/.llaves/
